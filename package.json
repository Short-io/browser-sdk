{
  "name": "@short.io/client-browser",
  "version": "1.0.0",
  "description": "Browser SDK for Short.io API with public key support",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "short.io",
    "url-shortener",
    "browser",
    "sdk",
    "client"
  ],
  "author": "Short.io",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Short-io/browser-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Short-io/browser-sdk/issues"
  },
  "homepage": "https://github.com/Short-io/browser-sdk#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/browser": "^4.1.8",
    "eslint": "^10.4.1",
    "msw": "^2.14.6",
    "playwright": "^1.60.0",
    "rollup": "^4.61.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "typescript": ">=4.0.0"
  },
  "engines": {
    "node": ">=14"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
